# Copy this file to .env and fill in your own values
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
PORT=9000
JWT_SECRET=any-long-random-string
SALT=10

# Cashfree (sandbox) - premium membership payments
Cashfree_ID=
Cashfree_Secret_Key=

# Cloudinary - stores downloaded CSV reports
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Google Gemini - AI category suggestion
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Gmail + App Password - password reset emails (if empty, emails are printed to the console)
EMAIL=
PASSWORD=
